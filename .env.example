DATABASE_BACKEND=sqlite
DATABASE_PATH=instance/educonnect.sqlite3
# Required for production; generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
SESSION_COOKIE_SECURE=false
# For MySQL / GCP Cloud SQL, set DATABASE_BACKEND=mysql:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=educonnect
DB_PASSWORD=
DB_NAME=edu_connect
# Optional Cloud SQL Unix socket on App Engine:
DB_UNIX_SOCKET=
